@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu – FPTU Cup";
    Layout = "_AuthLayout";
    var sent = TempData["Sent"] as string;
}

<div class="auth">
    <section class="auth-panel">
        <form class="auth-form" asp-controller="Account" asp-action="ForgotPassword" method="post">
            <a class="brand text-reset" asp-controller="Pages" asp-action="Home">
                <partial name="_BrandMark" />
                <span class="brand-name">FPTU CUP 2026</span>
            </a>
            <div class="field">
                <h2>Quên mật khẩu</h2>
                <p class="muted">Nhập email đã đăng ký, hệ thống sẽ gửi link đặt lại mật khẩu (hiệu lực 30 phút).</p>
            </div>

            @if (sent != null)
            {
                <div class="banner banner-info" role="status">
                    Nếu <b>@sent</b> thuộc một tài khoản đang hoạt động, email đặt lại mật khẩu đã được gửi.
                    Kiểm tra cả thư mục Spam. Không nhận được thì có thể gửi lại sau ít phút.
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="banner banner-error" role="alert"></div>

            <div class="field">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control input" autocomplete="email" placeholder="vd. anv@fpt.edu.vn">
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-lg" type="submit">Gửi link đặt lại mật khẩu</button>
            <a asp-controller="Account" asp-action="Login" class="text-center fw-semibold small-link">Quay lại đăng nhập</a>
            <p class="note text-center">Không còn dùng email đó? Liên hệ ban tổ chức để Admin đặt lại mật khẩu.</p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
