@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu – FPTU Cup";
    Layout = "_AuthLayout";
}

<div class="auth">
    <section class="auth-panel">
        <form class="auth-form" asp-controller="Account" asp-action="ResetPassword" method="post">
            <a class="brand text-reset" asp-controller="Pages" asp-action="Home">
                <partial name="_BrandMark" />
                <span class="brand-name">FPTU CUP 2026</span>
            </a>
            <div class="field">
                <h2>Đặt lại mật khẩu</h2>
                <p class="muted">Chọn mật khẩu mới cho tài khoản. Sau khi đổi, link này và các phiên đăng nhập cũ sẽ hết hiệu lực.</p>
            </div>
            <div asp-validation-summary="ModelOnly" class="banner banner-error" role="alert"></div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div class="field">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control input" autocomplete="new-password">
                <span class="hint">Tối thiểu 8 ký tự.</span>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control input" autocomplete="new-password">
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-lg" type="submit">Lưu mật khẩu mới</button>
            <a asp-controller="Account" asp-action="ForgotPassword" class="text-center fw-semibold small-link">Link hết hạn? Gửi lại link mới</a>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
