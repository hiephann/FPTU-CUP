@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập – FPTU Cup";
    Layout = "_AuthLayout";
}

<div class="auth">
    <section class="auth-aside">
        <a class="brand" asp-controller="Pages" asp-action="Home">
            <partial name="_BrandMark" />
            <span class="brand-name">FPTU CUP 2026</span>
        </a>

        <svg class="auth-pitch" viewBox="0 0 400 260" fill="none" stroke="#3D5A4B" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="396" height="256" rx="6"></rect>
            <line x1="200" y1="2" x2="200" y2="258"></line>
            <circle cx="200" cy="130" r="38"></circle>
            <circle cx="200" cy="130" r="3" fill="#3D5A4B"></circle>
            <rect x="2" y="70" width="56" height="120"></rect>
            <rect x="342" y="70" width="56" height="120"></rect>
            <rect x="2" y="105" width="20" height="50"></rect>
            <rect x="378" y="105" width="20" height="50"></rect>
            <path d="M58 105a28 28 0 010 50M342 105a28 28 0 000 50"></path>
            <circle cx="268" cy="96" r="9" stroke="#F2A23A" stroke-width="2.5"></circle>
            <path d="M120 170 C170 150 210 120 259 100" stroke="#F2A23A" stroke-dasharray="6 6"></path>
        </svg>

        <div>
            <h1 class="auth-title">Vào sân<br>điều hành giải</h1>
            <p class="auth-lead">Ban tổ chức quản lý lịch và kết quả, trọng tài ghi diễn biến trận, quản lý đội nộp đội hình trước giờ bóng lăn.</p>
        </div>
    </section>

    <section class="auth-panel">
        <form class="auth-form" id="login-form" asp-controller="Account" asp-action="Login" method="post">
            <div class="field">
                <h2>Đăng nhập</h2>
                <p class="muted">Dùng tài khoản được cấp hoặc tài khoản quản lý đội.</p>
            </div>

            @if (TempData["Success"] is string ok)
            {
                <div class="banner banner-info" role="status">@ok</div>
            }
            <div asp-validation-summary="ModelOnly" class="banner banner-error" role="alert"></div>

            <input type="hidden" asp-for="Next" />
            <div class="field">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control input" autocomplete="username" placeholder="vd. manager_cntt">
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="field">
                <div class="field-row">
                    <label asp-for="Password" class="form-label mb-0"></label>
                    <a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>
                <input asp-for="Password" class="form-control input" autocomplete="current-password">
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button class="btn btn-primary btn-lg" type="submit">Đăng nhập</button>

            <partial name="_DemoAccounts" />

            <div class="or">hoặc</div>
            <a class="btn btn-outline btn-block" asp-controller="Account" asp-action="Register">Đăng ký làm quản lý đội</a>
            <a asp-controller="Pages" asp-action="Home" class="text-center fw-semibold small-link">Xem giải không cần đăng nhập</a>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
