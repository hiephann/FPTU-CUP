@{
    // ViewData["Role"]: Admin | TeamManager | Referee – quyết định menu; quyền vào trang do [Authorize(Roles)] ở PagesController.
    var role = ViewData["Role"] as string ?? User.Role() ?? "Admin";
}
<!doctype html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body data-portal="@role">
<div class="admin">
    @* Admin luôn thấy menu Admin (kể cả khi đang ở trang quản lý đội / trọng tài) *@
    <partial name="_Sidebar" model="@(User.IsInRole("Admin") ? "Admin" : role)" />

    <div class="admin-body">
        <header class="topbar">
            <div class="inner">
                <button class="btn btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#portal-sidebar"
                        aria-controls="portal-sidebar" aria-label="Mở menu">☰ Menu</button>
                <div class="picker" id="tournament-picker">
                    <span class="note">Giải đang điều hành</span>
                    <label for="tournament-select" class="sr-only">Chọn giải đấu</label>
                    <select id="tournament-select"><option>Đang tải…</option></select>
                </div>
                <partial name="_UserBadge" />
            </div>
        </header>
        @RenderBody()
    </div>
</div>
<partial name="_Toast" />
<partial name="_CoreScripts" />
<script src="~/js/render.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
