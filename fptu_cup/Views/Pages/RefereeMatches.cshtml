    </div>

    <section class="panel">
        <div id="match-table"><p class="muted">Đang tải…</p></div>
        <p class="note">Trận chỉ bắt đầu được khi cả hai đội đã nộp đội hình (BR20).</p>
    </section>
</main>

@section Scripts {
    <script src="~/js/referee-matches.js" asp-append-version="true"></script>
}
