@{
    ViewData["Title"] = "Đăng ký quản lý đội – FPTU Cup";
    Layout = "_AuthLayout";
}

<div class="auth">
    <section class="auth-aside">
        <a class="brand" href="/">
            <partial name="_BrandMark" />
            <span class="brand-name">FPTU CUP 2026</span>
        </a>

        <ol class="steps">
            <li><b>1. Tạo tài khoản</b><span>Đăng ký với vai trò quản lý đội (Team Manager).</span></li>
            <li><b>2. Đăng ký đội</b><span>Khi giải mở đăng ký, khai báo tên đội, khoa, logo và màu áo.</span></li>
            <li><b>3. Thêm cầu thủ</b><span>Mỗi đội cần từ 7 đến 14 cầu thủ trước khi ban tổ chức duyệt.</span></li>
            <li><b>4. Nộp đội hình</b><span>Chọn 7 cầu thủ xuất phát (1 thủ môn) trước mỗi trận.</span></li>
        </ol>

        <div>
            <h1 class="auth-title">Lập đội<br>ra sân</h1>
            <p class="auth-lead">Tài khoản Admin và trọng tài do ban tổ chức cấp, chỉ quản lý đội mới tự đăng ký.</p>
        </div>
    </section>

    <section class="auth-panel">
        <form class="auth-form" id="register-form" novalidate>
            <div class="field">
                <h2>Đăng ký</h2>
                <p class="muted">Tạo tài khoản quản lý đội để đăng ký đội vào giải.</p>
            </div>
            <div class="field">
                <label for="fullName">Họ và tên</label>
                <input class="input" id="fullName" name="fullName" autocomplete="name" placeholder="vd. Nguyễn Văn A" required>
                <span class="field-error" data-error-for="fullName" hidden></span>
            </div>
            <div class="field">
                <label for="email">Email</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="vd. anv@fpt.edu.vn" required>
                <span class="field-error" data-error-for="email" hidden></span>
            </div>
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                <input class="input" id="username" name="username" autocomplete="username" placeholder="vd. manager_cntt" required>
                <span class="field-error" data-error-for="username" hidden></span>
            </div>
            <div class="field">
                <label for="password">Mật khẩu</label>
                <input class="input" id="password" name="password" type="password" autocomplete="new-password" required>
                <span class="hint">Tối thiểu 8 ký tự.</span>
                <span class="field-error" data-error-for="password" hidden></span>
            </div>
            <div class="field">
                <label for="confirm">Nhập lại mật khẩu</label>
                <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
                <span class="field-error" data-error-for="confirm" hidden></span>
            </div>
            <div class="banner banner-error" id="register-error" hidden></div>
            <button class="btn btn-primary btn-lg" type="submit">Tạo tài khoản</button>
            <a href="/login" style="text-align:center;font-size:14px;font-weight:600">Đã có tài khoản? Đăng nhập</a>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}
