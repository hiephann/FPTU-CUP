@{
    ViewData["Title"] = "Đăng nhập – FPTU Cup";
    Layout = "_AuthLayout";
}

<div class="auth">
    <section class="auth-aside">
        <a class="brand" href="/">
            <partial name="_BrandMark" />
            <span class="brand-name">FPTU CUP 2026</span>
        </a>

        <svg class="auth-pitch" viewBox="0 0 400 260" fill="none" stroke="#3D5A4B" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="396" height="256" rx="6"></rect>
            <line x1="200" y1="2" x2="200" y2="258"></line>
            <circle cx="200" cy="130" r="38"></circle>
            <circle cx="200" cy="130" r="3" fill="#3D5A4B"></circle>
            <rect x="2" y="70" width="56" height="120"></rect>
            <rect x="342" y="70" width="56" height="120"></rect>
            <rect x="2" y="105" width="20" height="50"></rect>
            <rect x="378" y="105" width="20" height="50"></rect>
            <path d="M58 105a28 28 0 010 50M342 105a28 28 0 000 50"></path>
            <circle cx="268" cy="96" r="9" stroke="#F2A23A" stroke-width="2.5"></circle>
            <path d="M120 170 C170 150 210 120 259 100" stroke="#F2A23A" stroke-dasharray="6 6"></path>
        </svg>

        <div>
            <h1 class="auth-title">Vào sân<br>điều hành giải</h1>
            <p class="auth-lead">Ban tổ chức quản lý lịch và kết quả, trọng tài ghi diễn biến trận, quản lý đội nộp đội hình trước giờ bóng lăn.</p>
        </div>
    </section>

    <section class="auth-panel">
        <form class="auth-form" id="login-form" novalidate>
            <div class="field">
                <h2>Đăng nhập</h2>
                <p class="muted">Dùng tài khoản được cấp hoặc tài khoản quản lý đội.</p>
            </div>
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                <input class="input" id="username" name="username" autocomplete="username" placeholder="vd. manager_cntt" required>
            </div>
            <div class="field">
                <label for="password">Mật khẩu</label>
                <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
            </div>
            <div class="banner banner-error" id="login-error" hidden></div>
            <button class="btn btn-primary btn-lg" type="submit">Đăng nhập</button>

            <details class="demo-accounts">
                <summary>Tài khoản mẫu (dữ liệu seed)</summary>
                <ul>
                    <li><b>Admin:</b> <button type="button" class="link-btn" data-fill="admin|Admin@123">admin / Admin@123</button></li>
                    <li><b>Quản lý đội CNTT FC:</b> <button type="button" class="link-btn" data-fill="manager_cntt|Manager@123">manager_cntt / Manager@123</button></li>
                    <li><b>Quản lý đội Điện tử FC (đang đăng ký):</b> <button type="button" class="link-btn" data-fill="manager_dt|Manager@123">manager_dt / Manager@123</button></li>
                    <li><b>Trọng tài:</b> <button type="button" class="link-btn" data-fill="referee1|Referee@123">referee1 / Referee@123</button></li>
                </ul>
            </details>

            <div class="or">hoặc</div>
            <a class="btn btn-outline btn-block" href="/register">Đăng ký làm quản lý đội</a>
            <a href="/" style="text-align:center;font-size:14px;font-weight:600">Xem giải không cần đăng nhập</a>
        </form>
    </section>
</div>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
