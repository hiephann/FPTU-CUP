@startuml uc_admin
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor White
skinparam usecaseBorderColor #333333
skinparam rectangleBorderColor #333333
left to right direction
actor "Admin\n(Organizer)" as Admin
rectangle "Student Football Tournament Management API" {
  usecase "Login / Logout" as UC1
  usecase "Change password" as UC3
  usecase "Manage accounts\n(create Referee, lock/unlock)" as UC4
  usecase "Manage tournaments\n(CRUD, change status, legs)" as UC5
  usecase "Approve / reject teams" as UC6
  usecase "Manage venues" as UC7
  usecase "Generate round-robin schedule" as UC8
  usecase "Manage matches\n(create, reschedule, assign referee)" as UC9
  usecase "Correct match result" as UC10
  usecase "View tournament summary" as UC11
}
Admin --> UC1
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
@enduml
